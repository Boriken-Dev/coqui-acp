{
 "provider_extra": {
  "request_max_retries": 0,
  "stream_max_retries": 0
 },
 "script": [
  {
   "status": 429,
   "message": "Rate limit reached",
   "kind": "rate_limit_exceeded"
  },
  {
   "status": 500,
   "message": "Internal server error"
  }
 ],
 "steps": [
  {
   "send": {
    "id": 1,
    "method": "initialize",
    "params": {
     "clientInfo": {
      "name": "coqui-acp-codex",
      "version": "0.0.0"
     },
     "capabilities": {}
    }
   }
  },
  {
   "until": {
    "id": 1
   }
  },
  {
   "send": {
    "method": "initialized",
    "params": {}
   }
  },
  {
   "send": {
    "id": 2,
    "method": "model/list",
    "params": {}
   }
  },
  {
   "until": {
    "id": 2
   }
  },
  {
   "send": {
    "id": 3,
    "method": "thread/start",
    "params": {
     "cwd": "{ROOT}/w",
     "approvalPolicy": "untrusted",
     "sandbox": "workspace-write",
     "developerInstructions": "Answer briefly.",
     "config": {
      "mcp_servers": {
       "echo": {
        "url": "http://127.0.0.1:{PORT}/mcp"
       }
      }
     }
    }
   }
  },
  {
   "until": {
    "id": 3
   }
  },
  {
   "send": {
    "id": 4,
    "method": "turn/start",
    "params": {
     "threadId": "{THREAD}",
     "input": [
      {
       "type": "text",
       "text": "Hit the limit."
      }
     ]
    }
   }
  },
  {
   "until": {
    "method": "turn/completed"
   },
   "timeout": 180
  },
  {
   "send": {
    "id": 5,
    "method": "turn/start",
    "params": {
     "threadId": "{THREAD}",
     "input": [
      {
       "type": "text",
       "text": "Fail."
      }
     ]
    }
   }
  },
  {
   "until": {
    "method": "turn/completed"
   },
   "timeout": 180
  },
  {
   "close": true
  }
 ]
}
