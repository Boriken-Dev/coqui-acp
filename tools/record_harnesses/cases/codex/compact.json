    }
   }
  },
  {
   "until": {
    "method": "turn/completed"
   },
   "timeout": 120
  },
  {
   "sleep": 2
  },
  {
   "send": {
    "id": 6,
    "method": "turn/start",
    "params": {
     "threadId": "{THREAD}",
     "input": [
      {
       "type": "text",
       "text": "And after?"
      }
     ]
    }
   }
  },
  {
   "until": {
    "method": "turn/completed"
   },
   "timeout": 120
