{
 "rollout": true,
 "script": [
  {
   "text": "First answer."
  },
  {
   "text": "Summary of the work so far."
  },
  {
   "text": "After the compaction."
  }
 ],
 "steps": [
  {
   "send": {
    "id": 1,
