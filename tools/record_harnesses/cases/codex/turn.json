{
 "rollout": true,
 "files": {
  "w/notes.txt": "one\ntwo\n"
 },
 "script": [
  {
   "reasoning": "Plan first, then edit.",
   "exec": "await tools.update_plan({explanation: 'Two steps', plan: [{step: 'Read notes.txt', status: 'completed'}, {step: 'Change two to three', status: 'in_progress'}]}); text('planned');"
  },
  {
   "exec": "const r = await tools.exec_command({cmd: 'echo checked > checked.txt', yield_time_ms: 10000}); text(JSON.stringify(r).slice(0, 300));"
  },
  {
   "exec": "const r = await tools.exec_command({cmd: 'del notes.txt', yield_time_ms: 10000}); text(JSON.stringify(r).slice(0, 300));"
  },
  {
   "exec": "const r = await tools.apply_patch('*** Begin Patch\\n*** Update File: notes.txt\\n@@\\n one\\n-two\\n+three\\n*** End Patch\\n'); text(JSON.stringify(r).slice(0, 300));"
  },
  {
   "exec": "const r = await tools.mcp__echo__echo({text: 'hi'}); text(JSON.stringify(r).slice(0, 300));"
  },
  {
   "text": "Changed two to three."
  },
  {
   "text": "Second turn answered."
  }
 ],
 "policy": [
  "accept",
  "decline",
  "acceptForSession",
  "accept",
  "accept"
 ],
 "steps": [
  {
   "send": {
    "id": 1,
    "method": "initialize",
    "params": {
     "clientInfo": {
      "name": "coqui-acp-codex",
      "version": "0.0.0"
     },
     "capabilities": {}
    }
   }
  },
  {
   "until": {
    "id": 1
   }
  },
  {
   "send": {
    "method": "initialized",
    "params": {}
   }
  },
  {
   "send": {
    "id": 2,
    "method": "model/list",
    "params": {}
   }
  },
  {
   "until": {
    "id": 2
   }
  },
  {
   "send": {
    "id": 3,
    "method": "thread/start",
    "params": {
     "cwd": "{ROOT}/w",
     "approvalPolicy": "untrusted",
     "sandbox": "workspace-write",
     "developerInstructions": "Answer briefly.",
     "config": {
      "mcp_servers": {
       "echo": {
        "url": "http://127.0.0.1:{PORT}/mcp"
       }
      }
     }
    }
   }
  },
  {
   "until": {
    "id": 3
   }
  },
  {
   "send": {
    "id": 4,
    "method": "turn/start",
    "params": {
     "threadId": "{THREAD}",
     "input": [
      {
       "type": "text",
       "text": "Change two to three in notes.txt."
      },
      {
       "type": "image",
       "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYPj/HwADAgH/kpmmpQAAAABJRU5ErkJggg=="
      }
     ],
     "effort": "low"
    }
   }
  },
  {
   "until": {
    "method": "turn/completed"
   },
   "timeout": 180
  },
  {
   "send": {
    "id": 5,
    "method": "turn/start",
    "params": {
     "threadId": "{THREAD}",
     "input": [
      {
       "type": "text",
       "text": "And now?"
      }
     ],
     "model": "gpt-6-luna",
     "effort": "medium"
    }
   }
  },
  {
   "until": {
    "method": "turn/completed"
   },
   "timeout": 120
  },
  {
   "close": true
  }
 ]
}
