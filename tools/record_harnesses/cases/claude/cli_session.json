{
 "argv": [
  "-p",
  "--input-format=stream-json",
  "--output-format=stream-json",
  "--verbose",
  "--replay-user-messages",
  "--permission-prompts=host",
  "--permission-prompt-tool=stdio",
  "--include-partial-messages",
  "--model=claude-haiku-5-5",
  "--setting-sources=",
  "--strict-mcp-config"
 ],
 "script": [
  {
   "text": "Named by the tool."
  }
 ],
 "steps": [
  {
   "send": {
    "type": "control_request",
    "request_id": "init-1",
    "request": {
     "subtype": "initialize"
    }
   }
  },
  {
   "until": {
    "type": "control_response"
   },
   "timeout": 60
  },
  {
   "send": {
    "type": "user",
    "message": {
     "role": "user",
     "content": [
      {
       "type": "text",
       "text": "Who named this session?"
      }
     ]
    }
   }
  },
  {
   "until": {
    "type": "result"
   },
   "timeout": 200
  },
  {
   "close": true
  }
 ]
}
