{
 "argv": [
  "-p",
  "--input-format=stream-json",
  "--output-format=stream-json",
  "--verbose",
  "--replay-user-messages",
  "--permission-prompts=host",
  "--permission-prompt-tool=stdio",
  "--include-partial-messages",
  "--session-id=6f2c1b0e-0000-4000-8000-00000000c0de",
  "--model=claude-haiku-5-5",
  "--effort=low",
  "--append-system-prompt=Answer briefly.",
  "--setting-sources=",
  "--strict-mcp-config",
  "--add-dir={ROOT}/extra"
 ],
 "files": {
  "w/notes.txt": "one\ntwo\n",
  "extra/readme.txt": "extra\n"
 },
 "script": [
  {
   "thinking": "I should plan first.",
   "text": "Planning the change.",
   "tools": [
    [
     "TodoWrite",
     {
      "todos": [
       {
        "content": "Read notes.txt",
        "status": "completed",
        "activeForm": "Reading notes.txt"
       },
       {
        "content": "Change two to three",
        "status": "in_progress",
        "activeForm": "Changing two to three"
       },
       {
        "content": "Check the result",
        "status": "pending",
        "activeForm": "Checking the result"
       }
      ]
     }
    ]
   ]
  },
  {
   "tools": [
    [
     "Read",
     {
      "file_path": "{ROOT}/w/notes.txt"
     }
    ]
   ]
  },
  {
   "tools": [
    [
     "Edit",
     {
      "file_path": "{ROOT}/w/notes.txt",
      "old_string": "two",
      "new_string": "three"
     }
    ]
   ]
  },
  {
   "tools": [
    [
     "Bash",
     {
      "command": "echo checked > checked.txt",
      "description": "Write a word"
     }
    ]
   ]
  },
  {
   "tools": [
    [
     "Write",
     {
      "file_path": "{ROOT}/w/new.txt",
      "content": "fresh\n"
     }
    ]
   ]
  },
  {
   "tools": [
    [
     "Grep",
     {
      "pattern": "three",
      "path": "{ROOT}/w",
      "output_mode": "content"
     }
    ]
   ]
  },
  {
   "text": "Changed two to three and wrote new.txt."
  },
  {
   "text": "Second turn answered."
  }
 ],
 "policy": [
  "allow",
  "deny",
  "always"
 ],
 "transcript": "6f2c1b0e-0000-4000-8000-00000000c0de",
 "steps": [
  {
   "send": {
    "type": "control_request",
    "request_id": "init-1",
    "request": {
     "subtype": "initialize"
    }
   }
  },
  {
   "until": {
    "type": "control_response"
   },
   "timeout": 60
  },
  {
   "send": {
    "type": "user",
    "message": {
     "role": "user",
     "content": [
      {
       "type": "text",
       "text": "Change two to three in notes.txt, then write new.txt."
      },
      {
       "type": "image",
       "source": {
        "type": "base64",
        "media_type": "image/png",
        "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNgYPj/HwADAgH/kpmmpQAAAABJRU5ErkJggg=="
       }
      },
      {
       "type": "text",
       "text": "<context ref=\"file:///{ROOT}/w/notes.txt\">\none\ntwo\n</context>"
      }
     ]
    }
   }
  },
  {
   "until": {
    "type": "result"
   },
   "timeout": 200
  },
  {
   "send": {
    "type": "control_request",
    "request_id": "model-1",
    "request": {
     "subtype": "set_model",
     "model": "claude-sonnet-5-5"
    }
   }
  },
  {
   "until": {
    "type": "control_response"
   },
   "timeout": 30
  },
  {
   "send": {
    "type": "control_request",
    "request_id": "effort-1",
    "request": {
     "subtype": "apply_flag_settings",
     "settings": {
      "effortLevel": "medium"
     }
    }
   }
  },
  {
   "until": {
    "type": "control_response"
   },
   "timeout": 30
  },
  {
   "send": {
    "type": "user",
    "message": {
     "role": "user",
     "content": [
      {
       "type": "text",
       "text": "And now?"
      }
     ]
    }
   }
  },
  {
   "until": {
    "type": "result"
   },
   "timeout": 200
  },
  {
   "close": true
  }
 ]
}
