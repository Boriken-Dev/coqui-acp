# Dotfiles are opt-in.
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Agent config and personal overrides, at any depth.
.agents
CLAUDE.md
CLAUDE.local.md
.claude
*.local.*

# Rust. A library does not commit its lockfile.
/target/
/Cargo.lock

# Python
__pycache__/

# Dart
.dart_tool/
/bindings/dart/coqui_acp/pubspec.lock

# Docs build
/site/

# The vectors copied beside the Dart tests for a browser run
/bindings/dart/coqui_acp/test/secret_vectors.json
