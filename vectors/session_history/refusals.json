{
  "why": "Documents a reader refuses, with the error code, the line and, for a wrongly shaped line, the JSON pointer. A case with `text` is the file's exact text; one with `lines` is those lines each ended by a line feed. Invalid UTF-8 cannot be written in JSON: a reader must also refuse it with code not_utf8 at its line.",
  "cases": [
    {
      "name": "empty_file",
      "why": "No bytes at all: there is no header.",
      "expect": {
        "code": "empty"
      },
      "text": ""
    },
    {
      "name": "header_not_json",
      "why": "Line 1 must be JSON.",
      "expect": {
        "code": "syntax",
        "line": 1
      },
      "lines": [
        "{not json"
      ]
    },
    {
      "name": "trailing_garbage",
      "why": "Anything after the JSON value is a syntax error.",
      "expect": {
        "code": "syntax",
        "line": 2
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}",
        "{\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"text\":\"hi\",\"type\":\"text\"}]}} x"
      ]
    },
    {
      "name": "no_final_line_feed",
      "why": "A file must end in a line feed: otherwise its last line may be cut.",
      "expect": {
        "code": "truncated",
        "line": 3
      },
      "text": "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}\n{\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"text\":\"hi\",\"type\":\"text\"}]}}\n{\"method\":\"history/turn_end\",\"params\":{\"stopReason\":\"end_turn\"}}"
    },
    {
      "name": "blank_line",
      "why": "Empty lines are not part of the format.",
      "expect": {
        "code": "blank_line",
        "line": 2
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}",
        "",
        "{\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"text\":\"hi\",\"type\":\"text\"}]}}"
      ]
    },
    {
      "name": "crlf_line_ending",
      "why": "Lines end in LF alone: the header's CR is the first.",
      "expect": {
        "code": "line_ending",
        "line": 1
      },
      "text": "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}\r\n{\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"text\":\"hi\",\"type\":\"text\"}]}}\r\n"
    },
    {
      "name": "cr_in_a_body_line",
      "why": "A carriage return anywhere in the file, here ending line 2.",
      "expect": {
        "code": "line_ending",
        "line": 2
      },
      "text": "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}\n{\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"text\":\"hi\",\"type\":\"text\"}]}}\r\n"
    },
    {
      "name": "first_line_is_body",
      "why": "The first line must be the header.",
      "expect": {
        "code": "unknown_format",
        "line": 1
      },
      "lines": [
        "{\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"text\":\"hi\",\"type\":\"text\"}]}}",
        "{\"method\":\"history/turn_end\",\"params\":{\"stopReason\":\"end_turn\"}}"
      ]
    },
    {
      "name": "wrong_format_name",
      "why": "Another format's first line.",
      "expect": {
        "code": "unknown_format",
        "line": 1
      },
      "lines": [
        "{\"format\": \"other\", \"version\": 1}"
      ]
    },
    {
      "name": "future_version",
      "why": "A version this reader does not know is refused whatever else the line holds.",
      "expect": {
        "code": "unknown_version",
        "line": 1
      },
      "lines": [
        "{\"format\": \"coqui-acp-history\", \"version\": 2, \"something\": \"new\"}"
      ]
    },
    {
      "name": "version_zero",
      "why": "Version 0 is not a version.",
      "expect": {
        "code": "unknown_version",
        "line": 1
      },
      "lines": [
        "{\"format\": \"coqui-acp-history\", \"version\": 0}"
      ]
    },
    {
      "name": "version_as_text",
      "why": "The version is a number.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/version"
      },
      "lines": [
        "{\"format\": \"coqui-acp-history\", \"version\": \"1\", \"id\": \"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\", \"origin\": {\"harness\": \"x\"}}"
      ]
    },
    {
      "name": "version_missing",
      "why": "The version is required.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/version"
      },
      "lines": [
        "{\"format\": \"coqui-acp-history\", \"id\": \"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\", \"origin\": {\"harness\": \"x\"}}"
      ]
    },
    {
      "name": "header_array",
      "why": "The header is an object.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": ""
      },
      "lines": [
        "[1]"
      ]
    },
    {
      "name": "id_missing",
      "why": "The host's session UUID is required.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/id"
      },
      "lines": [
        "{\"format\": \"coqui-acp-history\", \"version\": 1, \"origin\": {\"harness\": \"x\"}}"
      ]
    },
    {
      "name": "id_upper_case",
      "why": "A UUID is canonical lower case.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/id"
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5F0F6D6E-3F3C-4F1A-8A52-1C1E6F0B9A77\",\"origin\":{\"harness\":\"claude\"}}"
      ]
    },
    {
      "name": "id_not_uuid",
      "why": "The id is a UUID.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/id"
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"session-1\",\"origin\":{\"harness\":\"claude\"}}"
      ]
    },
    {
      "name": "origin_missing",
      "why": "The origin harness is required.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/origin"
      },
      "lines": [
        "{\"format\": \"coqui-acp-history\", \"version\": 1, \"id\": \"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\"}"
      ]
    },
    {
      "name": "harness_name_invalid",
      "why": "A harness name is lower-case letters, digits and . _ - : only.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/origin/harness"
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"Claude Code\"}}"
      ]
    },
    {
      "name": "header_unknown_field",
      "why": "An unknown header field is refused: use _meta.",
      "expect": {
        "code": "unknown_field",
        "line": 1,
        "pointer": ""
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"},\"extra\":1}"
      ]
    },
    {
      "name": "origin_unknown_field",
      "why": "An unknown origin field is refused.",
      "expect": {
        "code": "unknown_field",
        "line": 1,
        "pointer": "/origin"
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\",\"pid\":4}}"
      ]
    },
    {
      "name": "digest_malformed",
      "why": "A digest is sha256: and 64 hex digits.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/digest"
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"},\"digest\":\"sha256:abc\"}"
      ]
    },
    {
      "name": "created_at_malformed",
      "why": "Times are RFC 3339.",
