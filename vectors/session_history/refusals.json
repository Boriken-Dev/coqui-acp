      ]
    },
    {
      "name": "meta_not_object",
      "why": "_meta is an object.",
      "expect": {
        "code": "shape",
        "line": 1,
        "pointer": "/_meta"
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"},\"_meta\":3}"
      ]
    },
    {
      "name": "header_repeated",
      "why": "A second header, anywhere after line 1.",
      "expect": {
        "code": "order",
        "line": 3
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}",
        "{\"method\":\"session/prompt\",\"params\":{\"prompt\":[{\"text\":\"hi\",\"type\":\"text\"}]}}",
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}",
        "{\"method\":\"history/turn_end\",\"params\":{\"stopReason\":\"end_turn\"}}"
      ]
    },
    {
