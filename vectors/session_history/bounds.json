    {
      "name": "values_at_the_limit",
      "why": "Every scalar, array and object counts as a value, and so does every key of an object: the header holds 11 and the update 11.",
      "limits": {
        "max_values": 11
      },
      "lines": [
        "{\"format\":\"coqui-acp-history\",\"version\":1,\"id\":\"5f0f6d6e-3f3c-4f1a-8a52-1c1e6f0b9a77\",\"origin\":{\"harness\":\"claude\"}}",
