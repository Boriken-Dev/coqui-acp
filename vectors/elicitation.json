{
  "about": "An agent's elicitation/create, as both clients answer it, in ACP version 1. After initialize and session/new (session s1), the agent sends one elicitation/create with `params`. `elicitor` says whether the client was given one; `limits` replaces its defaults (fields 64, options 256). `asked` is what the elicitor is given, normalized: fields in the schema's order, each with `name`, `type` (text, choice, choices, number, integer, boolean or unsupported), `required`, and what the schema says of it that the client keeps; null when the elicitor is not asked. `answer` is what the elicitor answers. `response` is the client's whole answer: `result` or `error`, the error compared by code only. `blocked` says whether the client also reports that the request could not be answered. A client with an elicitor advertises `advertised` under clientCapabilities (v1) or capabilities (v2), and one without advertises no elicitation.",
  "advertised": {"elicitation": {"form": {}}},
  "cases": [
    {
      "name": "a form with every field type is given to the elicitor, and its answer is sent",
      "elicitor": true,
      "params": {
        "mode": "form",
        "sessionId": "s1",
        "toolCallId": "t1",
        "message": "A few questions",
        "requestedSchema": {
          "type": "object",
          "title": "Setup",
          "description": "Before I start",
          "properties": {
            "name": {"type": "string", "title": "Name", "description": "Yours", "minLength": 1, "maxLength": 40, "default": "Ana", "pattern": "^.*$"},
            "email": {"type": "string", "format": "email"},
            "color": {"type": "string", "title": "Color", "oneOf": [{"const": "r", "title": "Red", "description": "warm"}, {"const": "g", "title": "Green"}], "default": "g"},
            "size": {"type": "string", "enum": ["s", "m"]},
            "count": {"type": "integer", "minimum": 1, "maximum": 9, "default": 2},
            "ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "ok": {"type": "boolean", "default": true},
            "tags": {"type": "array", "title": "Tags", "minItems": 1, "maxItems": 2, "items": {"anyOf": [{"const": "a", "title": "A"}, {"const": "b", "title": "B"}]}, "default": ["a"]},
            "plain": {"type": "array", "items": {"type": "string", "enum": ["x", "y"]}}
          },
          "required": ["name", "color"]
        }
      },
      "asked": {
        "sessionId": "s1",
        "toolCallId": "t1",
        "message": "A few questions",
        "title": "Setup",
        "description": "Before I start",
        "fields": [
          {"name": "name", "type": "text", "required": true, "title": "Name", "description": "Yours", "minLength": 1, "maxLength": 40, "default": "Ana"},
          {"name": "email", "type": "text", "required": false, "format": "email"},
          {"name": "color", "type": "choice", "required": true, "title": "Color", "options": [{"value": "r", "title": "Red", "description": "warm"}, {"value": "g", "title": "Green"}], "default": "g"},
          {"name": "size", "type": "choice", "required": false, "options": [{"value": "s", "title": "s"}, {"value": "m", "title": "m"}]},
          {"name": "count", "type": "integer", "required": false, "minimum": 1, "maximum": 9, "default": 2},
          {"name": "ratio", "type": "number", "required": false, "minimum": 0, "maximum": 1},
          {"name": "ok", "type": "boolean", "required": false, "default": true},
          {"name": "tags", "type": "choices", "required": false, "title": "Tags", "options": [{"value": "a", "title": "A"}, {"value": "b", "title": "B"}], "minItems": 1, "maxItems": 2, "default": ["a"]},
          {"name": "plain", "type": "choices", "required": false, "options": [{"value": "x", "title": "x"}, {"value": "y", "title": "y"}]}
        ]
      },
      "answer": {"action": "accept", "content": {"name": "Bo", "color": "r", "size": "m", "count": 3, "ratio": 0.5, "ok": false, "tags": ["a", "b"], "plain": ["y"]}},
      "response": {"result": {"action": "accept", "content": {"name": "Bo", "color": "r", "size": "m", "count": 3, "ratio": 0.5, "ok": false, "tags": ["a", "b"], "plain": ["y"]}}},
      "blocked": false
    },
    {
      "name": "a decline is sent as the person's refusal",
